+def _fit_flat_colours(colours, counts, limit=32):
+    """More flat colours than the engine's CLUT rows -> (kept, {colour: row}).
+
+    The flat page holds one CLUT row per colour and a flat poly's id picks its
+    row, so a 33rd colour has no row - which used to stop the whole bake. The
+    `limit` most-used colours keep a row each (first appearance breaks a tie and
+    sets the row order, so a bake is stable); every other colour draws with the
+    kept colour nearest to it by eye (carbank_page's perceptual distance), and
+    the bake prints which.
+    """
+    import carbank_page
+
+    order = {c: i for i, c in enumerate(colours)}
+    keep = sorted(colours, key=lambda c: (-counts.get(c, 0), order[c]))[:limit]
+    keep.sort(key=lambda c: order[c])
+    index = {c: i for i, c in enumerate(keep)}
+    merged = []
+
+    for c in colours:
+        if c in index:
+            continue
+
+        near = min(range(len(keep)),
+                   key=lambda i: (carbank_page._colour_distance(c, keep[i]), i))
+        index[c] = near
+        merged.append((c, keep[near]))
+
+    shown = ", ".join("%02x%02x%02x->%02x%02x%02x" % (tuple(a) + tuple(b))
+                      for a, b in merged[:6])
+    print("   flat colours: %d distinct, the engine holds %d CLUT rows; %d drawn "
+          "with the nearest kept colour: %s%s"
+          % (len(colours), limit, len(merged), shown,
+             " ..." if len(merged) > 6 else ""))
+    return keep, index
+
