+#!/usr/bin/env python3
+"""When a page's colours do not fit its CLUT rows, every texel still shows the
+nearest colour the row it is DRAWN with holds - never another row's colours.
+
+    python -m unittest test_clut_fit -v
+
+Each test builds the case that used to come out as "confetti": a texel's 4-bit
+index read against a palette it was not chosen for.
+"""
+import json
+import os
+import shutil
+import struct
+import sys
+import tempfile
+import unittest
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, HERE)
+sys.path.insert(0, os.path.join(HERE, "..", "common"))
+
+import bankjson
+import carbank_bake
+import carbank_page
+import fourbpp
+import pages1
+
+W = H = fourbpp.PAGE_W
+BACKDROP = (8, 8, 8)
+
+
+def _blank():
+    return [BACKDROP] * (W * H)
+
+
+def _quad(x0, y0, x1, y1):
+    return [(x0, y0), (x1 - 1, y0), (x1 - 1, y1 - 1), (x0, y1 - 1)]
+
+
+def _texels(uvs):
+    return set(carbank_page._poly_texels(W, H, uvs))
+
+
+def _drawn(pixels, islands, indices, rows, pieces):
+    """{texel: (source colour, colour drawn)} for every texel a poly draws."""
+    out = {}
+
+    for own_id, lists in islands.items():
+        for uvs in lists:
+            rid = carbank_page.row_for_poly(uvs, own_id, pieces)
+            row = rows.get(rid, rows[min(rows)])
+
+            for t in _texels(uvs):
+                out[t] = (fourbpp.snap555(pixels[t]), tuple(row[indices[t]]))
+
+    return out
+
+
+def _wrong(drawn):
+    return {t: pair for t, pair in drawn.items() if pair[0] != pair[1]}
+
+
+class OutOfIdsTests(unittest.TestCase):
+    """Past texture id 31 a group used to overwrite its material's first row."""
+
+    def setUp(self):
+        # 40 panels on one material, ten colours each, no two of which fit one
+        # 16-entry row together: 32 get rows of their own, 8 must share.
+        self.pixels = _blank()
+        self.polys = []
+
+        for p in range(40):
+            x0, y0 = (p % 16) * 16, (p // 16) * 16
+            quad = _quad(x0, y0, x0 + 10, y0 + 8)
+            colours = [fourbpp.snap555((40 + 8 * i, 8 * (p % 32), 16 + 120 * (p // 32)))
+                       for i in range(10)]
+
+            for y in range(y0, y0 + 8):
+                for x in range(x0, x0 + 10):
+                    self.pixels[y * W + x] = colours[x - x0]
+
+            self.polys.append(quad)
+
+        self.islands = {0: list(self.polys)}
+
+    def plan(self):
+        report = {}
+        indices, rows, pieces = carbank_page.plan_islands(
+            self.pixels, W, H, self.islands, True, report=report)
+        return indices, rows, pieces, report
+
+    def test_the_first_groups_keep_their_exact_colours(self):
+        indices, rows, pieces, report = self.plan()
+
+        self.assertEqual(report["shared_rows"], 8)
+        self.assertTrue(all(0 <= rid < carbank_page.MAX_TEX_IDS for rid in rows))
+
+        first32 = {0: self.polys[:32]}
+        self.assertEqual(_wrong(_drawn(self.pixels, first32, indices, rows, pieces)), {})
+
+    def test_a_shared_group_shows_the_nearest_colour_its_row_holds(self):
+        indices, rows, pieces, _report = self.plan()
+
+        for uvs in self.polys[32:]:
+            rid = carbank_page.row_for_poly(uvs, 0, pieces)
+            row = rows[rid]
+
+            for t in _texels(uvs):
+                want = fourbpp.snap555(self.pixels[t])
+                got = tuple(row[indices[t]])
+                nearest = tuple(row[carbank_page._nearest_entry(want, row)])
+                self.assertEqual(carbank_page._colour_distance(want, got),
+                                 carbank_page._colour_distance(want, nearest))
+
+    def test_a_shared_row_takes_the_colours_it_has_room_for(self):
+        indices, rows, pieces, _report = self.plan()
+        exact = sum(1 for src, got in _drawn(self.pixels, {0: self.polys[32:]},
+                                             indices, rows, pieces).values()
+                    if src == got)
+
+        # every first-32 row holds ten colours and six free slots
+        self.assertGreater(exact, 0)
+
+
+class SplitPolyRowTests(unittest.TestCase):
+    """A poly the splitter put on a second row must be drawn with that row."""
+
+    def test_a_second_row_poly_under_a_first_row_rect(self):
+        pixels = _blank()
+        big = [(0, 0), (63, 0), (0, 63)]
+        small = [(40, 40), (60, 40), (40, 60)]
+        reds = [fourbpp.snap555((16 + 16 * i, 0, 0)) for i in range(10)]
+        blues = [fourbpp.snap555((0, 0, 16 + 16 * i)) for i in range(10)]
+        inner = _texels(small)
+
+        for t in _texels(big) | inner:
+            x = t % W
+            pixels[t] = blues[(x // 2) % 10] if t in inner else reds[(x // 6) % 10]
+
+        islands = {0: [big, small]}
+        indices, rows, pieces = carbank_page.plan_islands(pixels, W, H, islands, True)
+
+        self.assertNotEqual(carbank_page.row_for_poly(small, 0, pieces),
+                            carbank_page.row_for_poly(big, 0, pieces))
+        drawn = _drawn(pixels, {0: [small]}, indices, rows, pieces)
+        self.assertEqual(_wrong(drawn), {})
+
+    def test_the_bake_asks_the_same_rule(self):
+        pieces = [{"id": 0, "rect": [0, 0, 64, 64], "src": 0},
+                  {"id": 7, "rect": [40, 40, 61, 61], "src": 0}]
+        poly = {"id": 0, "uv": [(40, 40), (60, 40), (40, 60)]}
+
+        self.assertEqual(carbank_bake._id_at(poly, pieces), 7)
+
+
+class OverlapTests(unittest.TestCase):
+    """A later group's bbox must not recolour texels an earlier group draws."""
+
+    def test_two_materials_with_overlapping_bboxes(self):
+        pixels = _blank()
+        corner = [(32, 63), (63, 32), (63, 63)]          # material 0, drawn first
+        wedge = [(0, 0), (63, 0), (0, 63)]               # material 5, bbox covers it
+        reds = [fourbpp.snap555((24 + 32 * i, 8, 8)) for i in range(6)]
+        blues = [fourbpp.snap555((8, 8, 24 + 32 * i)) for i in range(6)]
+
+        for t in _texels(corner):
+            pixels[t] = blues[(t % W) % 6]
+
+        for t in _texels(wedge):
+            pixels[t] = reds[(t // W) % 6]
+
+        islands = {0: [corner], 5: [wedge]}
+        report = {}
+        indices, rows, pieces = carbank_page.plan_islands(
+            pixels, W, H, islands, True, report=report)
+
+        self.assertEqual(_wrong(_drawn(pixels, islands, indices, rows, pieces)), {})
+        self.assertGreater(report["fixed"], 0)
+        self.assertEqual(report["nearest"], 0)
+
+
+class TransparencyTests(unittest.TestCase):
+    """A visible texel never shares a slot pack_indexed clears."""
+
+    def test_an_alpha_hole_does_not_take_its_visible_twin_with_it(self):
+        # One panel, x 0..43. Its first four columns are an alpha hole whose
+        # hidden colour is reds[0]; the last four are VISIBLE reds[0]. Exact
+        # scatter gives both the same slot, and pack_indexed clears every slot
+        # an alpha-hole texel uses - so the visible twin used to vanish too.
+        pixels = _blank()
+        reds = [fourbpp.snap555((16 + 16 * i, 0, 0)) for i in range(10)]
+        blues = [fourbpp.snap555((0, 0, 16 + 16 * i)) for i in range(10)]
+        quad = _quad(0, 0, 44, 8)
+        other = _quad(128, 0, 168, 8)            # a second material: the page splits
+        mask = [False] * (W * H)
