+
+                if x < 4:
+                    hole.add(y * W + x)
+                    mask[y * W + x] = True
+
+            for x in range(128, 168):
+                pixels[y * W + x] = blues[(x - 128) // 4]
+
+        islands = {0: [quad], 3: [other]}
+        indices, rows, pieces = carbank_page.plan_islands(
+            pixels, W, H, islands, True, transparent=mask, key=None)
+        blob, _ordered = carbank_page.pack_indexed(indices, rows, mask=mask,
+                                                   key=None, pieces=pieces)
+        page_rows, raw = pages1.read_page(blob, 0, len(blob))
+        page = fourbpp.decode_indices(raw)
+        rid = carbank_page.row_for_poly(quad, 0, pieces)
+
+        def word(t):
