+class FlatColourTests(unittest.TestCase):
+    """A 33rd flat colour used to stop the D1 bake; now it borrows the nearest."""
+
+    def test_extra_flat_colours_draw_with_their_nearest_kept_colour(self):
+        import bake
+        import contextlib
+        import io
+
+        colours = [(8 * i, 255 - 8 * i, 64) for i in range(32)] + [
+            (8 * i + 3, 255 - 8 * i - 2, 66) for i in range(4)]
+        counts = {c: 5 for c in colours[:32]}
+        counts.update({c: 1 for c in colours[32:]})
+
+        with contextlib.redirect_stdout(io.StringIO()) as out:
+            keep, index = bake._fit_flat_colours(colours, counts)
+
+        self.assertEqual(keep, colours[:32])
+        self.assertEqual(set(index), set(colours))
+        self.assertTrue(all(0 <= row < 32 for row in index.values()))
+
+        for i, extra in enumerate(colours[32:]):
+            self.assertEqual(keep[index[extra]], colours[i], "its own near twin")
+
+        self.assertIn("4 drawn with the nearest kept colour", out.getvalue())
+
+    def test_the_most_used_colours_keep_their_rows(self):
+        import bake
+        import contextlib
+        import io
+
+        colours = [(i, i, i) for i in range(0, 34 * 7, 7)]
+        counts = {c: 1 for c in colours}
+        counts[colours[-1]] = 9                  # last seen, but used most
+
+        with contextlib.redirect_stdout(io.StringIO()):
+            keep, _index = bake._fit_flat_colours(colours, counts)
+
+        self.assertEqual(len(keep), 32)
+        self.assertIn(colours[-1], keep)
