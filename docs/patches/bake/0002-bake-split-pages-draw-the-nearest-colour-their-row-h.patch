+# ---------------------------------------------------------------------------
+# Which row draws a texel, and making every drawn texel show its own colour
+#
+# A page that does not fit one 16-entry row is split into several rows, and a
+# texel's 4-bit index only means something against the row it is drawn with.
+# Three things used to break that, each one the "confetti panel" look:
+#   * a group past texture id 31 overwrote its material's first row;
+#   * the centroid rule drew a poly the splitter had moved to a second row
+#     with its material's first row;
+#   * a later group's bbox re-indexed texels an earlier group's polys draw.
+# row_for_poly is the one answer to "which row draws this poly" (the bake asks
+# it too), and reconcile_rows makes the indices agree with it.
+# ---------------------------------------------------------------------------
+
+def _rect_texels(rect, width, height):
+    x0, y0, x1, y1 = _clip_rect(rect, width, height)
+    return [y * width + x for y in range(y0, y1) for x in range(x0, x1)]
+
+
+def _group_texels(width, height, rects, mask=None):
+    """Covered texels inside `rects`, each once - what a scatter writes."""
+    seen = set()
+    out = []
+
+    for rect in rects:
+        x0, y0, x1, y1 = _clip_rect(rect, width, height)
+
+        for y in range(y0, y1):
+            row = y * width
+
+            for x in range(x0, x1):
+                i = row + x
+
+                if i in seen or (mask is not None and not mask[i]):
+                    continue
+
+                seen.add(i)
+                out.append(i)
+
+    return out
+
+
+def _poly_texels(width, height, pts):
+    """The texels `_cover_poly` marks for one poly (the same raster)."""
+    hit = {}
+    _cover_poly(hit, width, height, pts)
+    return hit.keys()
+
+
+def _colour_distance(a, b):
+    """Perceptual distance between two 8-bit colours ("redmean" weighting).
+
+    Plain RGB distance weighs a step of blue like a step of green; the eye does
+    not. This keeps a dark red panel matching a dark red rather than a brown.
+    Used only for the re-matching below: fourbpp.nearest_clut_index keeps its
+    plain distance, because changing it would move bytes in every bank.
+    """
+    rmean = (a[0] + b[0]) >> 1
+    dr = a[0] - b[0]
+    dg = a[1] - b[1]
+    db = a[2] - b[2]
+    return (((512 + rmean) * dr * dr) >> 8) + 4 * dg * dg + (
+        ((767 - rmean) * db * db) >> 8)
+
+
+def _nearest_entry(colour, row, exclude=()):
+    """Index of `row`'s entry nearest `colour`, never one in `exclude`.
+
+    Pure black is the transparent marker on a keyed page, so a texel that is
+    not pure black never lands on a black entry while another entry exists -
+    the rule fourbpp.nearest_clut_index keeps too.
+    """
+    colour = tuple(colour)
+    black_ok = colour == (0, 0, 0)
+    best = None
+    bestd = None
+
+    for k, entry in enumerate(row):
+        if k in exclude:
+            continue
+
+        entry = tuple(entry)
+
+        if entry == (0, 0, 0) and not black_ok:
+            continue
+
+        d = _colour_distance(colour, entry)
+
+        if bestd is None or d < bestd:
+            best, bestd = k, d
+
+            if d == 0:
+                break
+
+    if best is None:
+        best = next((k for k in range(len(row)) if k not in exclude), 0)
+
+    return best
+
+
+def row_for_poly(uvs, own_id, rects):
+    """The CLUT row (texture id) a poly draws, given the planner's pieces.
+
+    `rects` are plan_islands' pieces (bank.json `clut_rects`). The planner puts
+    every poly's clipped UV bbox in exactly one group, and that group's row is
+    the palette the poly's texels were indexed against - so a piece whose rect
+    IS this poly's bbox, for this poly's own material, is the answer. That keeps
+    a poly the splitter moved to a second row on that row; before, a first-row
+    rect of the same material id under its centroid won, and the poly drew its
+    texels with the wrong 16 colours.
+
+    Otherwise (a hand-edited plan, or a poly the planner never saw): the
+    smallest rect the UV centroid lands in, a rect of the poly's own id wins a
+    tie, so a panel that was not split stays on the id its material named. A
+    leftover retail sprite (src is None - not a material) does not replace that
+    id: PAGE_1 stays on row 0 when its centroid only hits the leftover.
+    """
+    rects = list(rects or [])
+
+    if not rects:
+        return own_id
+
+    uvs = list(uvs or [])
+    fallback = rects[0]["id"]
+
+    if uvs and own_id is not None:
+        own_rect = [int(v) for v in _clip_rect(_bbox_uv(uvs), fourbpp.PAGE_W,
+                                               fourbpp.PAGE_H)]
+        exact = [r for r in rects if r.get("src") == own_id
+                 and [int(v) for v in r["rect"]] == own_rect]
+
+        if exact:
+            return exact[-1]["id"]          # the last group to write those texels
+
+    def material_row():
+        if any(r.get("id") == own_id and r.get("src") is not None for r in rects):
+            return own_id
+
+        # a material id past 31 was given another id: its first group's
+        moved = next((r for r in rects if r.get("src") == own_id), None)
+        return moved["id"] if moved is not None and own_id is not None else None
+
+    if not uvs:
+        if any(r["id"] == own_id for r in rects):
+            return own_id
+        kept = material_row()
+        return fallback if kept is None else kept
+
+    u = sum(p[0] for p in uvs) / float(len(uvs))
+    v = sum(p[1] for p in uvs) / float(len(uvs))
+    hit = [r for r in rects
+           if r["rect"][0] <= u < r["rect"][2] and r["rect"][1] <= v < r["rect"][3]]
+
+    if not hit:
+        kept = material_row()
+
+        if kept is not None:
+            return kept
+
+        return own_id if any(r["id"] == own_id for r in rects) else fallback
+
+    own = [r for r in hit if r["id"] == own_id]
+
+    if not own and hit and all(r.get("src") is None for r in hit):
+        kept = material_row()
+
+        if kept is not None:
+            return kept
+
+    chosen = own or hit
+    chosen.sort(key=lambda r: (r["rect"][2] - r["rect"][0]) * (r["rect"][3] - r["rect"][1]))
+    return chosen[0]["id"]
+
+
+def _slot_use(indices, pieces, rows, width, height, transparent=None, key=None,
+              tolerance=0, chroma=None):
+    """({row id: slots referenced}, {row id: slots pack_indexed will clear}).
+
+    Referenced = the index of every texel inside one of that row's rects - a
+    slot none of them uses is free to take a colour. Cleared mirrors
+    pack_indexed: a transparent texel inside the row's rects clears its slot
+    when there is no key, or when the entry still matches the key.
+    """
+    refs = {rid: set() for rid in rows}
+    bad = {rid: set() for rid in rows}
+
+    for piece in pieces:
+        rid = piece["id"]
+
+        if rid not in rows:
+            continue
+
+        row = rows[rid]
+
+        for t in _rect_texels(piece["rect"], width, height):
+            slot = indices[t]
+            refs[rid].add(slot)
+
+            if transparent is not None and transparent[t]:
+                if key is None or _key_matches(tuple(row[slot]), key,
+                                               tolerance, chroma):
+                    bad[rid].add(slot)
+
+    return refs, bad
+
+
+def _missing(hist, row, exclude=()):
+    """[(cost, colour)] for `hist` colours `row` does not hold, costliest first."""
+    present = {tuple(c) for k, c in enumerate(row) if k not in exclude}
+    out = []
+
+    for colour, count in hist.items():
+        if colour in present:
+            continue
+
+        k = _nearest_entry(colour, row, exclude)
+        out.append((count * _colour_distance(colour, row[k]), colour))
+
+    out.sort(key=lambda m: (-m[0], m[1]))
+    return out
+
+
+def _share_row(indices, pixels, width, height, rects, mask, rows, pieces,
+               transparent=None, key=None, tolerance=0, chroma=None):
+    """Put a group that has no texture id left onto the row that fits it best.
+
+    Each body row is scored by what the group would lose on it: every colour of
+    the group the row does not hold costs its texel count times its distance to
+    the row's nearest entry - except the costliest ones, which the row's free
+    (unreferenced) slots can take. The cheapest row wins; its free slots take
+    those colours and every texel is matched to the nearest colour the row then
+    holds. A transparent texel keeps a slot pack_indexed clears. Returns the
+    row id, or None when there is no row to share.
+    """
+    texels = _group_texels(width, height, rects, mask)
+
+    if not rows or not texels:
+        return None
+
+    clear = transparent if transparent is not None and any(transparent) else None
+    visible = [t for t in texels if clear is None or not clear[t]]
+    hidden = [t for t in texels if clear is not None and clear[t]]
+    hist = {}
+
+    for t in visible:
+        colour = fourbpp.snap555(pixels[t])
+        hist[colour] = hist.get(colour, 0) + 1
+
+    special = {p["id"] for p in pieces
+               if p.get("kind") == "wheel" or p.get("src") is None}
+    refs, bad = _slot_use(indices, pieces, rows, width, height, clear, key,
+                          tolerance, chroma)
+    best = None
+
+    for rid in sorted(rows):
+        if rid in special:
+            continue
+
+        free = [k for k in range(fourbpp.CLUT_ROW_ENTRIES) if k not in refs[rid]]
+        cost = sum(c for c, _colour in _missing(hist, rows[rid], bad[rid])[len(free):])
+
+        if best is None or cost < best[0]:
+            best = (cost, rid, free)
+
+    if best is None:
+        return None
+
+    _cost, rid, free = best
+    row = list(rows[rid])
+    barred = set(bad[rid])
+    hidden_slot = None
+
+    # The transparent texels' slot is settled first and barred to the visible
+    # ones: a slot pack_indexed clears must never also carry a visible texel.
+    if hidden:
+        if bad[rid]:
+            hidden_slot = min(bad[rid])
+        elif free:
+            hidden_slot = free.pop()
+            row[hidden_slot] = fourbpp.snap555(pixels[hidden[0]])
+            barred.add(hidden_slot)
+
+    for (_c, colour), slot in zip(_missing(hist, row, barred), list(free)):
+        row[slot] = colour
+
+    lookup = {}
+
+    for t in visible:
+        colour = fourbpp.snap555(pixels[t])
+
+        if colour not in lookup:
+            lookup[colour] = _nearest_entry(colour, row, barred)
+
+        indices[t] = lookup[colour]
+
+    if hidden_slot is not None:
+        for t in hidden:
+            indices[t] = hidden_slot
+
+    rows[rid] = row
+    return rid
+
+
+def reconcile_rows(indices, rows, pieces, islands, pixels, width, height,
+                   transparent=None, key=None, tolerance=0, chroma=None):
+    """Every texel a poly draws shows its own colour, or the nearest its row has.
+
+    For every poly the row it will draw with is the bake's own answer
+    (row_for_poly). A texel whose index does not show its colour in EVERY row
+    that draws it is moved:
+
+      * drawn by one row: to the slot already holding its colour; else to a
+        free (unreferenced) slot of that row, which takes the colour; else to
+        the nearest colour the row holds;
+      * drawn by several rows (a shared edge or a mirrored unwrap): to a slot
+        that holds the colour in all of them; else a slot free in all of them;
+        else the slot whose entries are nearest across all of them.
+
+    Transparent texels are left alone, and no visible texel is moved onto a
+    slot pack_indexed will clear. Wheel rects are left alone: a wheel row is
+    keyed by its own mask. A page with nothing to fix is not touched at all,
+    so its bytes do not change.
+
+    Returns {"checked", "fixed", "exact", "nearest", "shared", "worst"}:
+    texels drawn, texels moved, moved to their exact colour, moved to a
+    nearest colour, moved on a shared edge, and the worst channel error left.
+    """
+    report = {"checked": 0, "fixed": 0, "exact": 0, "nearest": 0,
+              "shared": 0, "worst": 0}
+
+    if not rows or not islands:
+        return report
+
+    clear = transparent if transparent is not None and any(transparent) else None
+    locked = set()
+
+    for piece in pieces:
+        if piece.get("kind") == "wheel":
+            locked.update(_rect_texels(piece["rect"], width, height))
+
+    fallback = min(rows)
+    draw = {}
+    done = set()
+
+    for own_id in sorted(islands):
+        for uvs in islands[own_id] or ():
+            if not uvs or len(uvs) < 3:
+                continue
+
+            poly_key = (own_id, tuple((int(p[0]), int(p[1])) for p in uvs))
+
+            if poly_key in done:
+                continue
+
+            done.add(poly_key)
+            rid = row_for_poly(uvs, own_id, pieces)
+
+            if rid not in rows:
+                rid = fallback          # pack_indexed's gap rule: the lowest id's row
+
+            for t in _poly_texels(width, height, uvs):
+                if t in locked or (clear is not None and clear[t]):
+                    continue
+
+                draw.setdefault(t, set()).add(rid)
+
+    report["checked"] = len(draw)
+    conflicts = {}
+
+    refs, bad = _slot_use(indices, pieces, rows, width, height, clear, key,
+                          tolerance, chroma)
+
+    for t, rids in draw.items():
+        colour = fourbpp.snap555(pixels[t])
+        k = indices[t]
+
+        for rid in rids:
+            refs[rid].add(k)
+
+        if all(tuple(rows[r][k]) == colour and k not in bad[r] for r in rids):
+            continue
+
+        conflicts.setdefault((tuple(sorted(rids)), colour), []).append(t)
+
+    if not conflicts:
+        return report
+
+    worst = 0
+
+    for (rids, colour), texels in sorted(conflicts.items()):
+        slot = None
+        exact = True
+        barred = set().union(*(bad[r] for r in rids))
+
+        for k in range(fourbpp.CLUT_ROW_ENTRIES):
+            if k not in barred and all(tuple(rows[r][k]) == colour for r in rids):
+                slot = k
+                break
+
+        if slot is None:
+            common = set(range(fourbpp.CLUT_ROW_ENTRIES))
+
+            for r in rids:
+                common -= refs[r]
+
+            if common:
+                slot = min(common)
+
+                for r in rids:
+                    rows[r] = list(rows[r])
+                    rows[r][slot] = colour
+
+        if slot is None:
+            exact = False
+
+            if len(rids) == 1:
+                slot = _nearest_entry(colour, rows[rids[0]], barred)
+            else:
+                best = None
+
+                for k in range(fourbpp.CLUT_ROW_ENTRIES):
+                    if k in barred:
+                        continue
+
+                    entries = [tuple(rows[r][k]) for r in rids]
+
+                    if colour != (0, 0, 0) and (0, 0, 0) in entries:
+                        continue
+
+                    total = sum(_colour_distance(colour, e) for e in entries)
+
+                    if best is None or total < best[0]:
+                        best = (total, k)
+
+                slot = best[1] if best is not None else indices[texels[0]]
+
+        for r in rids:
+            refs[r].add(slot)
+
+        for t in texels:
+            indices[t] = slot
+
+        report["fixed"] += len(texels)
+        report["exact" if exact else "nearest"] += len(texels)
+
+        if len(rids) > 1:
+            report["shared"] += len(texels)
+
+        if not exact:
+            for r in rids:
+                entry = rows[r][slot]
+                worst = max(worst, max(abs(colour[c] - entry[c]) for c in range(3)))
+
+    report["worst"] = worst
+    return report
+
+
 def _key_matches(colour, key, tolerance, chroma):
     if key is None:
         return True
