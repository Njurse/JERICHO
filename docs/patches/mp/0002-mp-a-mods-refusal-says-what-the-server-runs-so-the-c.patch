+/* The mods refusal, followed by what this host runs (MP_REJECT_MODLIST, mp_proto.h):
+ * a newer client offers to fetch what it lacks, an older one reads the MP_REJECT
+ * alone. The rows are the host's enabled mods without the tooling MpModsMatchHost
+ * ignores, and EXACT_SET is this host's rule: the client's set must be ours. */
+static void MpSendRejectMods(int connIndex)
+{
+	unsigned char buf[sizeof(MP_REJECT) + sizeof(MP_REJECT_MODLIST) + MP_MAX_MODS * sizeof(MP_MOD_INFO)];
+	MP_MOD_INFO hm[MP_MAX_MODS];
+	MP_REJECT r;
+	MP_REJECT_MODLIST t;
+	int hn = MpBuildManifest(hm, MP_MAX_MODS);
+	int i, len, count = 0;
+
+	memset(&r, 0, sizeof(r));
+	r.reason = (uint8_t)MP_REJECT_MODS;
+	snprintf(r.text, sizeof(r.text), "%s", "mod list does not match the host");
+	memcpy(buf, &r, sizeof(r));
+	len = (int)(sizeof(r) + sizeof(t));
+
+	for (i = 0; i < hn && count < MP_MAX_MODS; i++)
+	{
+		if (MpModIsTooling(hm[i].id))
+			continue;
+
+		memcpy(buf + len, &hm[i], sizeof(hm[i]));
+		len += (int)sizeof(hm[i]);
+		count++;
+	}
+
+	memset(&t, 0, sizeof(t));
+	memcpy(t.tag, MP_REJECT_MODLIST_TAG, sizeof(t.tag));
+	t.modCheck = (uint8_t)gMp.config.modCheck;
+	t.flags = MP_REJECT_MODLIST_F_EXACT_SET;
+	t.count = (uint8_t)count;
+	memcpy(buf + sizeof(r), &t, sizeof(t));
+
+	MpSendConn(connIndex, MP_TAG_REJECT, 0, buf, len);
+}
+
+/* What a mods refusal says the server runs, handed to jer_joinmods, which works
+ * out what would let us in, checks the player's mod repos and ASKS before fetching
+ * anything. The comparison is made there, against the SAVED mod set (what the
+ * relaunch will start from), with MpModsMatchHost's rules: tooling never counts
+ * (MpModIsTooling's ids go along as `ignore`), under MP_MODCHECK_EXACT a version
+ * must match (an empty one: any), and EXACT_SET means our other mods must be off.
+ * `q`/`n` are the bytes after the MP_REJECT - nothing from an older server. */
+static void MpOfferServerMods(const unsigned char* q, int n)
+{
+	static const char* const tooling[] = { "bake", "d1cars" };	/* = MpModIsTooling */
+	MP_REJECT_MODLIST t;
+	JER_JOIN_MOD rows[MP_MAX_MODS];
+	int sn, i, flags = 0;
+	char addr[96];
+
+	if (q == NULL || n < (int)sizeof(t))
+		return;
+
+	memcpy(&t, q, sizeof(t));
+
+	if (memcmp(t.tag, MP_REJECT_MODLIST_TAG, sizeof(t.tag)) != 0)
+		return;
+
+	/* a wire count: bounded by the rows array and by the bytes that came */
+	sn = t.count;
+	if (sn > MP_MAX_MODS)
+		sn = MP_MAX_MODS;
+	if (sn > (n - (int)sizeof(t)) / (int)sizeof(MP_MOD_INFO))
+		sn = (n - (int)sizeof(t)) / (int)sizeof(MP_MOD_INFO);
+
+	for (i = 0; i < sn; i++)
+	{
+		MP_MOD_INFO row;
+
+		memcpy(&row, q + sizeof(t) + (size_t)i * sizeof(MP_MOD_INFO), sizeof(MP_MOD_INFO));
+		memset(&rows[i], 0, sizeof(rows[i]));
+		snprintf(rows[i].id, sizeof(rows[i].id), "%.*s", MP_MOD_ID_MAX - 1, row.id);	/* never trusted terminated */
+		snprintf(rows[i].version, sizeof(rows[i].version), "%.*s", MP_MOD_VER_MAX - 1, row.version);
+	}
+
+	if (t.modCheck == MP_MODCHECK_EXACT)
+		flags |= JER_JOIN_EXACT;
+	if (t.flags & MP_REJECT_MODLIST_F_EXACT_SET)
+		flags |= JER_JOIN_EXACT_SET;
+
+	if (sJoinPort > 0)
+		snprintf(addr, sizeof(addr), "%s:%d", sJoinHost, sJoinPort);
+	else
+		snprintf(addr, sizeof(addr), "%s", sJoinHost);
+
+	if (gMpCtx)
+		gMpCtx->jer_log(gMpCtx, "[mp] the server runs %d mod(s)%s%s - offering what would let us in\n", sn,
+			(flags & JER_JOIN_EXACT) ? ", versions exact" : "", (flags & JER_JOIN_EXACT_SET) ? ", no others" : "");
+
+	jer_joinmods_offer(addr, rows, sn, tooling, (int)(sizeof(tooling) / sizeof(tooling[0])), flags);
+}
