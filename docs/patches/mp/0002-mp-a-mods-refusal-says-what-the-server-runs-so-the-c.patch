diff --git a/mp_proto.h b/mp_proto.h
index 6eb56a3..c1e0358 100644
--- a/mp_proto.h
+++ b/mp_proto.h
@@ -450,6 +450,32 @@ typedef struct MP_REJECT
 	char     text[MP_REJECT_TEXT_MAX];
 } MP_REJECT;
 
+/* An MP_REJECT_MODS refusal may be followed by WHAT THE SERVER RUNS: this header
+ * (MP_REJECT_MODLIST), then `count` MP_MOD_INFO rows -- the mods a client must
+ * have switched on (the listen host's own enabled mods; a dedicated server's
+ * core_mods + mods), tooling (bake) left out. With it the client can offer to fetch what it lacks from the
+ * player's mod repos instead of stopping at "mod list does not match"
+ * (JERICHO jer_joinmods).
+ *
+ * No protocol bump. MpHandleReject has always required len >= sizeof(MP_REJECT)
+ * and read nothing past it, so an older client still shows the refusal and stops;
+ * a newer client talking to an older server finds no tag and does the same.
+ *
+ * A row's version binds only when modCheck is MP_MODCHECK_EXACT, and an empty one
+ * means any version will do (a dedicated server that names no version for it). */
+#define MP_REJECT_MODLIST_TAG	"JPMR"
+#define MP_REJECT_MODLIST_F_EXACT_SET	0x1	/* the client's OTHER mods are refused too: its
+						 * enabled set must be the server's (the listen
+						 * host's rule; a dedicated server with `mods`) */
+typedef struct MP_REJECT_MODLIST
+{
+	char     tag[4];	/* MP_REJECT_MODLIST_TAG */
+	uint8_t  modCheck;	/* MP_MODCHECK_* the server enforces */
+	uint8_t  flags;		/* MP_REJECT_MODLIST_F_* */
+	uint8_t  count;		/* MP_MOD_INFO rows that follow, at most MP_MAX_MODS */
+	uint8_t  reserved;
+} MP_REJECT_MODLIST;
+
 /* The host's SESSION RULES, packed into ONE byte. They travel three ways and the
  * three must stay in step: MP_WELCOME.rules (join in progress), the free bits
  * of MP_SESSION.spare (the launch path, shifted up by one because spare's bit 0
@@ -969,6 +995,7 @@ static_assert(sizeof(MP_MOD_INFO) == 42, "MP_MOD_INFO layout");
 static_assert(sizeof(MP_HELLO) == 44, "MP_HELLO layout");
 static_assert(sizeof(MP_WELCOME) == 18, "MP_WELCOME layout");	/* 18 since v11 (rules) */
 static_assert(sizeof(MP_REJECT) == 68, "MP_REJECT layout");
+static_assert(sizeof(MP_REJECT_MODLIST) == 8, "MP_REJECT_MODLIST layout");	/* the JPMR trailer */
 static_assert(sizeof(MP_SESSION) == 12, "MP_SESSION layout");
 static_assert(sizeof(MP_PLAYER_INPUT) == 4, "MP_PLAYER_INPUT layout");
 static_assert(sizeof(MP_INPUT) == 4, "MP_INPUT layout");
diff --git a/tools/mp_test.py b/tools/mp_test.py
index 62441d2..1935852 100644
--- a/tools/mp_test.py
+++ b/tools/mp_test.py
@@ -188,6 +188,13 @@ HELLO = struct.Struct("<HHHH32s4B")      # 44 bytes
 MODI = struct.Struct("<24s16sBB")        # 42 bytes
 WELCOME = struct.Struct("<12BIBB")      # 18 bytes: 12xu8, u32 seed, u8 hostCar, u8 rules (mp_proto.h static_assert -- v11 ADDED `rules`; a 17-byte <12BIB is refused by MpHandleWelcome's length gate)
 REJECT = struct.Struct("<4B64s")         # 68 bytes
+# The trailer an MP_REJECT_MODS refusal may carry (mp_proto.h MP_REJECT_MODLIST): what
+# the server runs, so the client can offer to fetch what it lacks. Tag, modCheck,
+# flags, count, reserved -- then `count` MODI rows. Old clients read REJECT alone.
+REJECT_MODLIST = struct.Struct("<4sBBBB")  # 8 bytes
+REJECT_MODLIST_TAG = b"JPMR"               # mp_proto.h MP_REJECT_MODLIST_TAG
+REJECT_MODLIST_F_EXACT_SET = 0x1           # mp_proto.h MP_REJECT_MODLIST_F_EXACT_SET
+MAX_MODS = 32                              # mp_proto.h MP_MAX_MODS
 BEACON = struct.Struct("<IHH32s6BHH")    # 50 bytes; the last u16 is `rules` (mp_proto.h renamed MP_BEACON's `spare` to it -- same offset, same size, so the wire is unchanged)
 CHANNEL = struct.Struct("<16sHIBB2B")    # 26 bytes
 # Byte offset of MP_CHANNEL.fromPlayer. A relay must stamp this with the sender's real
@@ -334,6 +341,43 @@ REJECT_NAMES = {0: "NONE", 1: "FULL", 2: "VERSION", 3: "MODS", 4: "INPROGRESS",
 REJECT_IDS = {v.lower(): k for k, v in REJECT_NAMES.items() if k != 0}
 
 
+def pack_reject_modlist(mod_check, rows, exact_set):
+    """The JPMR trailer for an MP_REJECT_MODS refusal (mp_proto.h MP_REJECT_MODLIST).
+
+    `rows` are (id, version) the client must have switched on, at most MAX_MODS; an
+    empty version means any. `exact_set`: the client's OTHER mods are refused too.
+    A field keeps one byte for its terminator, as the C side expects.
+    """
+    rows = list(rows)[:MAX_MODS]
+    out = REJECT_MODLIST.pack(REJECT_MODLIST_TAG, int(mod_check) & 0xFF,
+                              REJECT_MODLIST_F_EXACT_SET if exact_set else 0, len(rows), 0)
+    for mod_id, version in rows:
+        out += MODI.pack(str(mod_id).encode("latin1", "replace")[:MOD_ID_MAX - 1],
+                         str(version or "").encode("latin1", "replace")[:MOD_VER_MAX - 1], 1, 0)
+    return out
+
+
+def parse_reject_modlist(payload):
+    """(mod_check, exact_set, [(id, version)]) from a whole REJECT payload, or None
+    when it carries no JPMR trailer (an older server). Rows are bounded by the count,
+    by MAX_MODS and by the bytes that came -- the same rules as MpOfferServerMods."""
+    off = REJECT.size
+    if len(payload) < off + REJECT_MODLIST.size:
+        return None
+    tag, check, flags, count, _res = REJECT_MODLIST.unpack_from(payload, off)
+    if tag != REJECT_MODLIST_TAG:
+        return None
+    rows = []
+    pos = off + REJECT_MODLIST.size
+    for _ in range(min(count, MAX_MODS)):
+        if pos + MODI.size > len(payload):
+            break
+        mod_id, version, _en, _r = MODI.unpack_from(payload, pos)
+        rows.append((cstr(mod_id), cstr(version)))
+        pos += MODI.size
+    return check, bool(flags & REJECT_MODLIST_F_EXACT_SET), rows
+
+
 def cstr(raw):
     return raw.split(NUL)[0].decode(errors="replace")
 
