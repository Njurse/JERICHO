+def reject_modlist(cfg):
+    """The JPMR trailer for this server's mods refusal (mp_proto.h MP_REJECT_MODLIST).
+
+    It tells the client what to switch on so it can offer to fetch the rest from the
+    player's mod repos (JERICHO jer_joinmods) instead of stopping at "mod list does
+    not match". The rows are mods_match's own requirements: core_mods plus `mods`,
+    tooling left out, each with its mod_versions entry when the check is exact (an
+    empty version means any). `mods` non-empty is mods_match's equal-set rule, so it
+    also says the client's other mods are refused. Old clients ignore the trailer.
+    """
+    tooling = ("bake", "d1cars")
+    level = int(cfg.get("mod_check", 0) or 0)
+    required = list(cfg.get("mods") or [])
+    versions = cfg.get("mod_versions") or {}
+    rows, seen = [], set()
+
+    for mod_id in list(cfg.get("core_mods") or []) + required:
+        if mod_id in tooling or mod_id in seen:
+            continue
+        seen.add(mod_id)
+        rows.append((mod_id, versions.get(mod_id, "") if level >= 2 else ""))
+
+    return m.pack_reject_modlist(level, rows, exact_set=bool(required))
+
+
