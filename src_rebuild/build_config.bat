@echo off
rem build_config.bat <configuration> <exe basename> - the shared MSVC build.
rem
rem   build_config.bat Release      JERICHO       shipping build
rem   build_config.bat Release_dev  JERICHO_dev   debug options + console + dev tooling
rem
rem Normally you want build_jericho.bat (Release). See the note there for why, and
rem README.md "Building the game". This script exists so both configurations get
rem the same treatment; it is what those two helpers call.
rem
rem Works from any current directory.
rem
rem Why this is more than one msbuild call
rem --------------------------------------
rem exports.def tells the linker what the exe exports. It is GENERATED by
rem gen_exports from a LINKER MAP, so the committed copy matches exactly ONE
rem configuration - whichever a developer built last. It is handed to the linker
rem for EVERY configuration, so linking a configuration against a def shaped for
rem the other one fails: LNK2001 on every module entry this configuration does not
rem link. It is not a stale-artifact nuisance to ignore; it is a hard link error.
rem
rem So build per configuration, the way the CI workflow does:
rem
rem   pass 1   link against a throwaway empty def - that link writes the .map
rem   pass 2   gen_exports turns THAT configuration's map into the def, then relink
rem
rem The committed def is put back afterwards, so the repository is left as it was
rem found and the two configurations never trip over each other. gen_exports
rem records which map it read on the def's first line, so when the def is already
rem shaped for this configuration the whole dance is skipped and this is a single
rem build.
setlocal
cd /d "%~dp0"

set "CFG=%~1"
set "EXE=%~2"
if "%CFG%"=="" set "CFG=Release"
if "%EXE%"=="" set "EXE=JERICHO"

set "MAP=bin\%CFG%\%EXE%.map"
set "DEF=exports.def"
set "KEEP=exports.def.keep"

call "C:\Program Files (x86)\Microsoft Visual Studio\2019\Community\VC\Auxiliary\Build\vcvars64.bat" >nul 2>&1

findstr /C:"%MAP%" "%DEF%" >nul 2>&1
if not errorlevel 1 goto single

echo [build] exports.def is not shaped for %CFG% - regenerating it
echo [build] %CFG% pass 1/2: link to produce %MAP%
copy /Y "%DEF%" "%KEEP%" >nul
> "%DEF%" echo EXPORTS
msbuild build\JERICHO.sln /p:Configuration=%CFG% /p:Platform=x64 /m /v:m /nologo
if errorlevel 1 goto fail

echo [build] %CFG% pass 2/2: gen_exports from this configuration's map, then relink
"bin\%CFG%\gen_exports.exe" "%MAP%" "%DEF%"
if errorlevel 1 goto fail
msbuild build\JERICHO.sln /p:Configuration=%CFG% /p:Platform=x64 /m /v:m /nologo
if errorlevel 1 goto fail

copy /Y "%KEEP%" "%DEF%" >nul
del "%KEEP%" >nul
endlocal & exit /b 0

:fail
set "RC=%errorlevel%"
if exist "%KEEP%" copy /Y "%KEEP%" "%DEF%" >nul & del "%KEEP%" >nul
endlocal & exit /b %RC%

:single
msbuild build\JERICHO.sln /p:Configuration=%CFG% /p:Platform=x64 /m /v:m /nologo
endlocal & exit /b %errorlevel%
